---
import type { Card } from '../lib/content';
import Icon from './Icon.astro';
import Img from './Img.astro';
interface Props { card: Card; industry: string }
const { card, industry } = Astro.props;
// only offer "Role details" when the full write-up says more than the summary
const hasMore = card.html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim().length > card.summary.length + 20;
const apply = `/submit-your-resume/?position=${encodeURIComponent(card.title)}`;
---
<article class="job card card-hover">
  {card.image ? (
    <div class="job-img"><Img src={card.image} alt="" sizes="(max-width: 680px) 92vw, (max-width: 1024px) 45vw, 380px" /></div>
  ) : null}
  <div class="job-body">
    <div class="meta">
      {card.location && <span class="chip loc"><Icon name="pin" />{card.location}</span>}    </div>
    <h3>{card.title}</h3>
    <p class="sum">{card.summary}</p>
    {hasMore && <details>
      <summary>Role details <Icon name="chevron" /></summary>
      <div class="prose" set:html={card.html} />
    </details>}
    <a href={apply} class="btn btn-primary btn-sm apply">Apply now <Icon name="arrow" /></a>
  </div>
</article>

<style>
  .job { display: flex; flex-direction: column; overflow: hidden; }
  .job-img { aspect-ratio: 16 / 9; overflow: hidden; background: var(--soft); }
  .job-img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .job:hover .job-img :global(img) { transform: scale(1.04); }
  .job-body { padding: 24px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip.loc { background: #e7f8fd; color: #0b7fa3; }
  h3 { font-size: 21px; line-height: 1.25; }
  .sum { color: var(--muted); font-size: 15px; }
  details { border-top: 1px solid var(--line); padding-top: 4px; margin-top: auto; }
  summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-weight: 600; color: var(--brand); font-size: 15px; }
  summary::-webkit-details-marker { display: none; }
  summary svg { width: 16px; height: 16px; transition: transform .25s var(--ease); }
  details[open] summary svg { transform: rotate(180deg); }
  details .prose { margin-top: 12px; font-size: 15px; }
  .apply { align-self: flex-start; margin-top: auto; }
</style>
