---
import IndustryCard from './IndustryCard.astro';
import Icon from './Icon.astro';
import { industries } from '../data/industries';
---
<ul class="ind-grid">
  {industries.map((i) => <li><IndustryCard industry={i} /></li>)}
  <li class="not-sure">
    <span class="ns-label">Not sure?</span>
    <p>Tell us about your role and we’ll match you with the right sector specialist.</p>
    <a href="/hire-talent/" class="btn btn-teal">Start a Search <Icon name="arrow" /></a>
  </li>
</ul>

<style>
  .ind-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(14px, 1.6vw, 22px); }
  .not-sure { display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 14px; padding: 26px 24px; border-radius: 12px; color: #d3dfeb;
    background: radial-gradient(80% 90% at 100% 100%, rgba(23, 166, 180, .4), transparent 60%), linear-gradient(140deg, #0b2440, #12385f); }
  .ns-label { font-family: var(--font-head); font-weight: 600; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: #7fd0dc; }
  .not-sure p { font-family: var(--font-head); font-size: 19px; font-weight: 600; line-height: 1.35; color: #fff; }
  @media (max-width: 1100px) { .ind-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .ind-grid { grid-template-columns: 1fr; } }
</style>
