---
import Icon from './Icon.astro';
interface Props { title: string; eyebrow?: string; image?: string; lead?: string; crumbs?: { label: string; href?: string }[] }
const { title, eyebrow, image, lead, crumbs = [] } = Astro.props;
---
<section class="phero bg-dark">
  {image && <img class="phero-bg" src={image} alt="" width="1920" height="900" fetchpriority="high" decoding="async" />}
  <div class="phero-shade"></div>
  <div class="grid-pattern"></div>
  <div class="container phero-in">
    <nav aria-label="Breadcrumb">
      <ol class="crumbs">
        <li><a href="/">Home</a></li>
        {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</li>)}
        <li aria-current="page">{title}</li>
      </ol>
    </nav>
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 class="h1">{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .phero { position: relative; overflow: hidden; padding: clamp(64px, 9vw, 120px) 0 clamp(56px, 7vw, 96px); isolation: isolate; }
  .phero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .phero-shade {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(100deg, rgba(6, 10, 43, .96) 0%, rgba(6, 10, 43, .82) 45%, rgba(18, 26, 86, .55) 100%),
                radial-gradient(60% 90% at 100% 100%, rgba(53, 30, 224, .45), transparent 60%);
  }
  .phero-in { position: relative; display: grid; gap: 18px; justify-items: start; }
  .phero h1 { max-width: 900px; }
  .phero .lead { max-width: 680px; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 14px; color: var(--muted-on-dark); margin-bottom: 8px; }
  .crumbs li + li::before { content: '/'; margin-right: 8px; opacity: .5; }
  .crumbs a:hover { color: #fff; }
  .crumbs [aria-current] { color: #fff; }
  .phero :global(.hero-actions) { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 600px) { .phero-shade { background: linear-gradient(180deg, rgba(6, 10, 43, .9), rgba(6, 10, 43, .82)), radial-gradient(80% 60% at 100% 100%, rgba(53, 30, 224, .45), transparent 60%); } .phero { padding: 44px 0 48px; } .phero-in { gap: 14px; } .crumbs { font-size: 13px; } .phero :global(.hero-actions) { justify-self: stretch; } .phero :global(.hero-actions .btn) { flex: 1 1 150px; } }
  @media (max-width: 420px) { .phero :global(.hero-actions .btn) { flex-basis: 100%; } }
</style>
