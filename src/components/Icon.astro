---
{isFilled ? (
  <svg {...rest} class={cls} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={filled[name]} />
) : (
  <svg {...rest} class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={stroke[name] ?? stroke.arrow} />
)}
