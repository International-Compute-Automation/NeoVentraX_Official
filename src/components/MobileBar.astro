---
import Icon from './Icon.astro';
---
<div class="mbar" id="mbar" aria-hidden="true">
  <a href="/submit-your-resume/" class="btn btn-ghost" tabindex="-1">Submit Resume</a>
  <a href="/posting-clients-jobs-or-request-for-assistance/" class="btn btn-primary" tabindex="-1">Hire Talent <Icon name="arrow" /></a>
</div>

<script>
  // Mobile quick actions: appear once the visitor scrolls past the first screen
  const bar = document.getElementById('mbar')!;
  const mq = matchMedia('(max-width: 680px)');
  const update = () => {
    const show = mq.matches && window.scrollY > window.innerHeight * 0.6;
    bar.classList.toggle('show', show);
    bar.setAttribute('aria-hidden', String(!show));
    bar.querySelectorAll('a').forEach((a) => a.tabIndex = show ? 0 : -1);
  };
  addEventListener('scroll', update, { passive: true });
  mq.addEventListener('change', update);
  update();
</script>

<style>
  .mbar { display: none; }
  @media (max-width: 680px) {
    .mbar {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 90; display: flex; gap: 10px;
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
      background: rgba(255, 255, 255, .94); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      border-top: 1px solid var(--line); box-shadow: 0 -8px 24px -12px rgba(10, 16, 64, .2);
      transform: translateY(110%); transition: transform .3s var(--ease);
    }
    .mbar.show { transform: none; }
    .mbar .btn { flex: 1; padding: 14px 12px; font-size: 15px; white-space: nowrap; }
    :global(html.no-scroll) .mbar { display: none; }
    :global(body:has(.mbar)) { padding-bottom: calc(70px + env(safe-area-inset-bottom)); }
  }
</style>
