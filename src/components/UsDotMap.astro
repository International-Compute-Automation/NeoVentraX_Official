---
/** Decorative dotted map of the contiguous USA with a pin (generated at build time — no image download). */
interface Props { pin?: [number, number]; class?: string }
const { pin = [-89.65, 39.78], class: cls } = Astro.props; // default: Springfield, IL

// simplified outline (lon, lat)
const outline: [number, number][] = [
  [-124.7, 48.4], [-123, 49], [-95, 49], [-94.8, 49.4], [-89.6, 48], [-84.8, 46.5], [-82.4, 45.3], [-82.5, 43], [-79, 43.5],
  [-76.8, 43.6], [-75, 45], [-71.5, 45], [-69.2, 47.4], [-67.8, 47], [-67, 44.8], [-70.7, 43], [-70, 41.8], [-71.9, 41.3],
  [-74, 40.6], [-75.5, 39.4], [-76, 38], [-75.7, 36], [-76.5, 34.7], [-78.5, 33.8], [-81, 32], [-81.4, 30.6], [-80.1, 27],
  [-80.4, 25.2], [-81.8, 25.9], [-82.8, 28], [-84, 30], [-86, 30.4], [-89, 30.2], [-90, 29.2], [-93.5, 29.7], [-94.8, 29.4],
  [-97.2, 27.6], [-97.4, 25.9], [-99.2, 26.6], [-101.4, 29.8], [-103, 29], [-104.7, 29.9], [-106.5, 31.8], [-108.2, 31.3],
  [-111, 31.3], [-114.8, 32.5], [-117.1, 32.5], [-118.5, 34], [-120.6, 34.6], [-121.9, 36.6], [-122.5, 37.8], [-123.8, 39.8],
  [-124.4, 42], [-124, 46.3],
];
const inside = (x: number, y: number) => {
  let c = false;
  for (let i = 0, j = outline.length - 1; i < outline.length; j = i++) {
    const [xi, yi] = outline[i], [xj, yj] = outline[j];
    if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) c = !c;
  }
  return c;
};
const K = Math.cos((38 * Math.PI) / 180); // squash longitude so the shape isn't stretched
const W0 = -125, N0 = 49.5;
const px = (lon: number) => (lon - W0) * K * 10;
const py = (lat: number) => (N0 - lat) * 10;
const dots: [number, number][] = [];
for (let lat = 49; lat >= 25; lat -= 0.95) for (let lon = -124.5; lon <= -67; lon += 0.95 / K) if (inside(lon, lat)) dots.push([px(lon), py(lat)]);
const w = Math.ceil(px(-66.5)), h = Math.ceil(py(24.5));
const [pxp, pyp] = [px(pin[0]), py(pin[1])];
---
<svg class={cls} viewBox={`0 0 ${w} ${h}`} role="img" aria-label="Map of the United States with our office marked in Springfield, Illinois">
  <g fill="#c9d6e3">{dots.map(([x, y]) => <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="2.6" />)}</g>
  <g transform={`translate(${pxp.toFixed(1)} ${pyp.toFixed(1)})`}>
    <circle r="16" fill="#17a6b4" opacity=".18" />
    <path d="M0 4c-7-8-11-13-11-18a11 11 0 0 1 22 0c0 5-4 10-11 18z" fill="#0f8b9c" transform="translate(0 -6)" />
    <circle cy="-20" r="4" fill="#fff" />
  </g>
</svg>
