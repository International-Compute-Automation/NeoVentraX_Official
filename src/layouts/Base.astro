---
import '@fontsource/outfit/400.css';
import '@fontsource/outfit/500.css';
import '@fontsource/outfit/600.css';
import '@fontsource/outfit/700.css';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';

interface Props { title: string; description?: string; heroImage?: string; quickActions?: boolean }
const { title, description, heroImage, quickActions = true } = Astro.props;
const isHome = Astro.url.pathname === '/';
const fullTitle = isHome ? 'NeoVentraX — Smarter Hiring & Career Growth' : `${title} | NeoVentraX`;
const desc = description || 'NeoVentraX connects employers with top talent and professionals with career opportunities across 20+ industries — recruitment, staffing, payroll and HR solutions.';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NeoVentraX" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(heroImage ?? '/uploads/2025-09-2-min.webp', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#060a2b" />
    <link rel="icon" type="image/webp" href="/uploads/2025-08-cropped-Neo-Ventrax-Logo.webp" />
    <link rel="apple-touch-icon" href="/uploads/2025-08-cropped-Neo-Ventrax-Logo.webp" />
    {heroImage && <link rel="preload" as="image" href={heroImage} fetchpriority="high" />}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'EmploymentAgency', name: 'NeoVentraX', url: 'https://neoventrax.com',
      telephone: '+1-872-227-9172', email: 'hr@neoventrax.com',
      address: { '@type': 'PostalAddress', streetAddress: '2501 Chatham Rd', addressLocality: 'Springfield', addressRegion: 'IL', postalCode: '62704', addressCountry: 'US' },
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {quickActions && <MobileBar />}
  </body>
</html>
