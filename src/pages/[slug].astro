---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import InfoCard from '../components/InfoCard.astro';
import Related from '../components/Related.astro';
import CtaBand from '../components/CtaBand.astro';
import { getPage, textOf, GENERAL_PAGES } from '../lib/content';

// rendered on each request (the menu and footer show the live sectors); only the general pages exist here
if (!GENERAL_PAGES.some((g) => g.slug === Astro.params.slug)) return Astro.rewrite('/404/');
const page = getPage(Astro.params.slug!);
const description = page.description || textOf(page.intro).slice(0, 155) || undefined;
const cols = (n: number) => (n === 1 ? 'grid-1' : n % 3 === 0 ? 'grid-3' : 'grid-2');
---
<Base title={page.title} description={description} heroImage={page.heroImage}>
  <PageHero title={page.title} eyebrow={page.categoryLabel} image={page.heroImage} crumbs={[{ label: page.categoryLabel, href: page.categoryLabel === 'Insights' ? '/insights/' : undefined }]} />

  {page.intro && (
    <section class="section-sm intro-sec">
      <div class="container intro">
        <span class="eyebrow">Overview</span>
        <div class="intro-body">
          <div class="prose lead-prose" data-clamp set:html={page.intro} />
          <button type="button" class="more-btn" hidden aria-expanded="false">Read more</button>
        </div>
      </div>
    </section>
  )}

  {page.groups.map((g, gi) => (
    <section class:list={['section-sm', { 'bg-soft': gi % 2 === 1 }]}>
      <div class="container">
        {(g.heading || g.lead) && (
          <div class="section-head">
            {g.heading && <h2 class="h2">{g.heading}</h2>}
            {g.lead && <div class="prose lead-prose" set:html={g.lead} />}
          </div>
        )}
        {g.cards.length > 0 && (
          <div class:list={['grid', cols(g.cards.length)]}>
            {g.cards.map((c, i) => <InfoCard card={c} index={i} wide={g.cards.length === 1} />)}
          </div>
        )}
      </div>
    </section>
  ))}

  <Related page={page} />
  <CtaBand />
</Base>

<script>
  // On phones, collapse long intros behind "Read more" (full text stays in the HTML for SEO)
  const mq = matchMedia('(max-width: 680px)');
  document.querySelectorAll<HTMLElement>('[data-clamp]').forEach((el) => {
    const btn = el.nextElementSibling as HTMLButtonElement;
    const apply = () => {
      el.classList.remove('clamped');
      const long = mq.matches && el.scrollHeight > 300;
      btn.hidden = !long;
      if (long && btn.getAttribute('aria-expanded') !== 'true') el.classList.add('clamped');
    };
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Show less' : 'Read more';
      el.classList.toggle('clamped', !open);
    });
    mq.addEventListener('change', apply);
    apply();
  });
</script>

<style>
  .intro-sec { padding-bottom: 0; }
  .intro { display: grid; grid-template-columns: 220px 1fr; gap: 32px; padding-bottom: clamp(48px, 6vw, 80px); }
  .lead-prose { font-size: clamp(17px, 1.4vw, 19px); line-height: 1.75; max-width: 860px; }
  .grid-1 { grid-template-columns: 1fr; }
  .lead-prose.clamped { max-height: 13.2em; overflow: hidden; -webkit-mask-image: linear-gradient(#000 60%, transparent); mask-image: linear-gradient(#000 60%, transparent); }
  .more-btn { margin-top: 10px; min-height: 44px; padding: 0 2px; border: 0; background: none; cursor: pointer; font-family: var(--font-head); font-weight: 600; font-size: 16px; color: var(--brand); }
  @media (max-width: 860px) { .intro { grid-template-columns: 1fr; gap: 14px; } }
</style>
