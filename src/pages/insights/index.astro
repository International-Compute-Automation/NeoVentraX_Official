---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Img from '../../components/Img.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { pagesIn, textOf } from '../../lib/content';

// Knowledge articles (for now: existing pages; to be managed by the CMS)
const articles = pagesIn('employees').map((p) => ({
  href: `/${p.slug}/`,
  title: p.title,
  image: p.heroImage,
  excerpt: (p.description || textOf(p.intro) || textOf(p.groups[0]?.lead ?? '')).slice(0, 150).replace(/\s+\S*$/, '') + '…',
}));
---
<Base title="Insights" description="Career and hiring insights from NeoVentraX — job search, resumes, interviews and career development." heroImage="/uploads/2025-09-2-min.webp">
  <PageHero
    title="Insights"
    eyebrow="Knowledge hub"
    image="/uploads/2025-09-2-min.webp"
    lead="Hiring trends, career guidance and recruitment insights from the NeoVentraX team."
  />
  <section class="section-sm bg-soft">
    <div class="container">
      <ul class="grid grid-3">
        {articles.map((a) => (
          <li>
            <a href={a.href} class="post">
              {a.image && <span class="post-img"><Img src={a.image} alt="" sizes="(max-width: 680px) 92vw, (max-width: 1024px) 45vw, 380px" /></span>}
              <span class="post-body">
                <span class="tag">Career guidance</span>
                <strong>{a.title}</strong>
                <span class="ex">{a.excerpt}</span>
                <span class="more">Read More <Icon name="arrow" /></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .post { display: flex; flex-direction: column; height: 100%; background: #fff; border-radius: 12px; overflow: hidden; border: 1px solid var(--line); transition: transform .3s var(--ease), box-shadow .3s var(--ease); }
  .post:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .post-img { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--soft); }
  .post-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .post-body { display: flex; flex-direction: column; gap: 10px; padding: 22px; flex: 1; }
  .tag { font-family: var(--font-head); font-size: 12.5px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--teal); }
  .post strong { font-family: var(--font-head); font-size: 20px; color: var(--ink); line-height: 1.3; }
  .ex { color: var(--muted); font-size: 15px; }
  .more { margin-top: auto; padding-top: 6px; display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-head); font-weight: 600; color: var(--brand); }
  .more :global(svg) { width: 16px; height: 16px; }
  @media (hover: none) { .post:hover { transform: none; } }
</style>
