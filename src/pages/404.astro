---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Page not found" description="The page you were looking for could not be found.">
  <PageHero title="Page not found" eyebrow="404" lead="The page you’re looking for has moved or no longer exists.">
    <div class="hero-actions">
      <a href="/" class="btn btn-primary">Back to home</a>
      <a href="/contact-us/" class="btn btn-ghost">Contact us</a>
    </div>
  </PageHero>
</Base>
