---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import IndustryGrid from '../components/IndustryGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/nav';

const pillars = [
  { icon: 'search', title: 'Focused Talent Research', text: 'Identify relevant professionals through targeted market research and sourcing.' },
  { icon: 'clipboard', title: 'Structured Screening', text: 'Evaluate candidates against role requirements, experience and qualifications.' },
  { icon: 'handshake', title: 'Recruitment Partnership', text: 'Maintain clear communication and support throughout the hiring process.' },
];
const approach = [
  { icon: 'target', title: 'Non-IT Recruitment Focus', text: 'A dedicated focus on professional and operational roles outside the IT sector.' },
  { icon: 'search', title: 'Research-Driven Sourcing', text: 'Targeted candidate research rather than relying exclusively on inbound applications.' },
  { icon: 'settings', title: 'Role-Specific Evaluation', text: 'Candidate screening aligned with job requirements, qualifications and relevant experience.' },
  { icon: 'chat', title: 'Clear Recruitment Communication', text: 'Structured updates and coordination throughout the recruitment engagement.' },
];
const testimonials = [
  { name: 'David Chen', role: 'Operations Director, Construction Firm', avatar: '/uploads/2025-07-it-services-5-nyt-7-png.webp',
    quote: 'We struggled to recruit experienced professionals for our large-scale projects. NeoVentraX provided us with highly qualified candidates in record time. Their streamlined process saved us hours of effort and ensured we had the right people in place to keep our projects on track.' },
  { name: 'James Miller', role: 'HR Manager', avatar: '/uploads/2025-07-it-services-5-nyt-8-png.webp',
    quote: 'Finding the right talent was always a challenge for us. NeoVentraX simplified the process with reliable recruitment support. Within weeks, we had skilled professionals onboard, matching our requirements. Their commitment to quality hiring has been a game-changer.' },
];
const faqs = [
  { q: 'Which industries do you recruit for?', a: 'We specialize in Non-IT recruitment across seven sectors: Engineering, Legal & Compliance, Taxation & Finance, Manufacturing, Supply Chain, Human Resources and Executive Search.' },
  { q: 'What types of hiring do you support?', a: 'Direct hire (permanent) recruitment, contract staffing, contract-to-hire and executive search — whether you need a single specialist or are building out a department.' },
  { q: 'How long does it take to fill a position?', a: 'Timelines depend on the role, location and market, but our research-led sourcing typically produces a shortlist of screened candidates within days to a few weeks.' },
  { q: 'Do you work with job seekers too?', a: 'Yes. Professionals in our industries can submit their resume and we’ll match them with suitable openings and support them through the process.' },
];
---
<Base title="Home" description="NeoVentraX helps US businesses identify and recruit qualified Non-IT professionals across engineering, legal, finance, manufacturing, supply chain and HR — plus executive search." heroImage="/uploads/2025-09-Construction-min-scaled.webp">
  <!-- HERO -->
  <section class="hero">
    <img class="hero-bg" src="/uploads/2025-09-Construction-min-scaled.webp"
         srcset="/uploads/2025-09-Construction-min-scaled-768.webp 768w, /uploads/2025-09-Construction-min-scaled.webp 1920w"
         sizes="100vw" alt="" width="1920" height="1282" fetchpriority="high" />
    <div class="hero-shade"></div>
    <div class="container hero-copy">
      <span class="eyebrow">Specialized Non-IT Recruitment</span>
      <h1>The Right Talent. The Right Fit. The Right Time.</h1>
      <p class="hero-sub">Building stronger businesses through smarter hiring.</p>
      <p class="hero-text">
        NeoVentraX helps US businesses identify and recruit qualified Non-IT professionals across specialized industries.
        We bring focused talent research, structured screening and a commitment to finding the right fit for every role.
      </p>
      <div class="hero-cta">
        <a href="/hire-talent/" class="btn btn-primary">Hire Talent <Icon name="arrow" /></a>
        <a href="#industries" class="btn btn-outline-white">Explore Our Expertise</a>
      </div>
    </div>
  </section>

  <!-- SPECIALIZED RECRUITMENT -->
  <section class="section-sm">
    <div class="container">
      <div class="split-head">
        <h2 class="h2 title-rule">Specialized Recruitment. Focused Expertise.</h2>
        <div class="split-text">
          <p>At NeoVentraX, we believe successful hiring starts with understanding the role, the industry and the people behind the business.</p>
          <p>Our recruitment approach combines targeted talent research, skill-based evaluation and structured candidate engagement to help employers identify professionals who align with their hiring requirements.</p>
        </div>
      </div>
      <ul class="grid grid-3 tiles">
        {pillars.map((p) => (
          <li class="tile">
            <span class="tile-ico"><Icon name={p.icon} /></span>
            <div><h3>{p.title}</h3><p>{p.text}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="section-sm bg-soft" id="industries">
    <div class="container">
      <div class="section-head center">
        <h2 class="h2">Talent Solutions Across Essential Sectors.</h2>
        <p class="lead">Every industry has unique hiring requirements. Our approach focuses on understanding the skills, experience and qualifications that matter within each sector.</p>
      </div>
      <IndustryGrid />
    </div>
  </section>

  <!-- SERVICES BAND -->
  <section class="svc-band">
    <div class="container svc-grid">
      <div class="svc-copy">
        <h2 class="h2">Recruitment Solutions Built Around Your Hiring Needs.</h2>
        <p>Whether you need to fill an individual position or strengthen an entire department, NeoVentraX provides recruitment support aligned with your workforce requirements.</p>
        <a href="/services/" class="btn btn-outline-white">Our services <Icon name="arrow" /></a>
      </div>
      <ul class="svc-panel">
        {services.map((s) => (
          <li>
            <a href={`/services/#${s.id}`}>
              <Icon name={s.icon} />
              <strong>{s.label}</strong>
              <span>{s.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FOCUSED APPROACH -->
  <section class="section-sm">
    <div class="container">
      <div class="split-head">
        <h2 class="h2 title-rule">A More Focused Approach to Non-IT Recruitment.</h2>
        <div class="split-text">
          <p>Hiring the right professional requires more than matching keywords on a resume. It requires an understanding of the position, industry requirements and the qualities that contribute to long-term success.</p>
          <a href="/our-process/" class="link-arrow">See our recruitment process <Icon name="arrow" /></a>
        </div>
      </div>
      <ul class="grid grid-4 tiles">
        {approach.map((p) => (
          <li class="tile stack">
            <span class="tile-ico"><Icon name={p.icon} /></span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section-sm bg-soft">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Client testimonials</span>
        <h2 class="h2">Trusted by Hiring Teams.</h2>
      </div>
      <div class="grid grid-2">
        {testimonials.map((t) => (
          <figure class="quote card">
            <div class="stars" aria-label="5 out of 5 stars">{[1, 2, 3, 4, 5].map(() => <Icon name="star" />)}</div>
            <blockquote>“{t.quote}”</blockquote>
            <figcaption>
              <img src={t.avatar} alt="" width="52" height="52" loading="lazy" />
              <span><strong>{t.name}</strong>{t.role}</span>
              <Icon name="quote" class="qmark" />
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-sm">
    <div class="container faq-grid">
      <div class="faq-intro">
        <h2 class="h2 title-rule">Frequently Asked Questions.</h2>
        <p class="lead">Can’t find what you’re looking for? Our team is happy to help.</p>
        <a href="/contact-us/" class="btn btn-ghost">Contact us <Icon name="arrow" /></a>
      </div>
      <div class="faq">
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}<span class="pm"><Icon name="plus" /></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* hero */
  .hero { position: relative; overflow: hidden; isolation: isolate; color: #fff; padding: clamp(64px, 8vw, 104px) 0; }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 30% 60%; transform: scaleX(-1); z-index: -2; } /* mirrored so the workers sit on the right */
  .hero-shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(8, 31, 58, .97) 0%, rgba(8, 31, 58, .9) 38%, rgba(10, 40, 72, .45) 70%, rgba(10, 40, 72, .15) 100%); }
  .hero-copy { display: grid; gap: 18px; justify-items: start; }
  .hero .eyebrow { color: #e6eef7; }
  .hero h1 { color: #fff; font-size: clamp(36px, 4.6vw, 58px); line-height: 1.08; max-width: 740px; }
  .hero-sub { font-family: var(--font-head); font-size: clamp(19px, 1.9vw, 24px); font-weight: 500; color: #fff; }
  .hero-text { max-width: 600px; font-size: 17px; color: #d8e3ef; line-height: 1.7; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 8px; }

  /* split heading + text (reference: title | divider | paragraphs) */
  .split-head { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(28px, 5vw, 64px); align-items: start; margin-bottom: clamp(32px, 4vw, 48px); }
  .split-head .h2 { font-size: clamp(30px, 3.2vw, 40px); }
  .split-text { display: grid; gap: 14px; padding-left: clamp(0px, 4vw, 48px); border-left: 1px solid #c9d6e2; color: var(--text); font-size: 16.5px; justify-items: start; }

  /* soft tiles */
  .tile { display: flex; gap: 18px; align-items: flex-start; padding: 26px 24px; border-radius: 10px; background: var(--soft); border: 1px solid #e3ecf3; }
  .tile.stack { flex-direction: column; gap: 12px; }
  .tile-ico { color: var(--brand); flex: none; }
  .tile-ico :global(svg) { width: 38px; height: 38px; stroke-width: 1.6; }
  .tile h3 { font-size: 19px; margin-bottom: 6px; }
  .tile.stack h3 { margin: 6px 0 0; }
  .tile p { color: var(--muted); font-size: 15px; line-height: 1.55; }

  /* services band */
  .svc-band { position: relative; color: #fff; padding: clamp(48px, 6vw, 72px) 0; background: linear-gradient(100deg, #0b2440 0%, #12385f 100%); overflow: hidden; }
  .svc-band::before { content: ''; position: absolute; inset: 0; background: url(/uploads/2025-09-Manufacturing-min-scaled-768.webp) left center / cover; opacity: .12; mix-blend-mode: luminosity; }
  .svc-grid { position: relative; display: grid; grid-template-columns: .8fr 1.6fr; gap: clamp(28px, 4vw, 48px); align-items: center; }
  .svc-copy { display: grid; gap: 16px; justify-items: start; }
  .svc-copy .h2 { color: #fff; font-size: clamp(28px, 2.9vw, 36px); }
  .svc-copy p { color: #d3dfeb; }
  .svc-panel { display: grid; grid-template-columns: repeat(4, 1fr); background: #fff; border-radius: 12px; padding: 12px; box-shadow: 0 30px 60px -30px rgba(0, 0, 0, .5); }
  .svc-panel li + li { border-left: 1px solid var(--line); }
  .svc-panel a { display: grid; justify-items: center; align-content: start; text-align: center; gap: 10px; padding: 22px 16px; height: 100%; border-radius: 8px; transition: background .2s; }
  .svc-panel a:hover { background: var(--soft); }
  .svc-panel :global(svg) { width: 36px; height: 36px; color: var(--brand); stroke-width: 1.6; }
  .svc-panel strong { font-family: var(--font-head); font-size: 18px; color: var(--ink); line-height: 1.25; }
  .svc-panel span { font-size: 14.5px; color: var(--muted); line-height: 1.55; }

  /* testimonials */
  .quote { padding: clamp(26px, 3.5vw, 38px); display: grid; gap: 20px; border-radius: 12px; }
  .stars { display: flex; gap: 3px; color: #f2a516; }
  .stars svg { width: 18px; height: 18px; }
  .quote blockquote { font-size: 17px; line-height: 1.7; color: var(--text); }
  .quote figcaption { display: flex; align-items: center; gap: 14px; padding-top: 20px; border-top: 1px solid var(--line); }
  .quote figcaption img { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; }
  .quote figcaption span { display: grid; font-size: 14px; color: var(--muted); line-height: 1.4; }
  .quote figcaption strong { color: var(--ink); font-size: 16px; font-family: var(--font-head); }
  .qmark { width: 38px; height: 38px; margin-left: auto; color: #d6e6f1; }

  /* faq */
  .faq-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .faq-intro { display: grid; gap: 20px; justify-items: start; position: sticky; top: calc(var(--header-h) + 24px); }
  .faq-intro .h2 { font-size: clamp(30px, 3.2vw, 40px); }
  .faq { display: grid; gap: 12px; }
  .faq details { border: 1px solid var(--line); border-radius: 10px; background: #fff; transition: border-color .2s, box-shadow .2s; }
  .faq details[open] { border-color: #c4d9e8; box-shadow: var(--shadow-sm); }
  .faq summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 22px; font-family: var(--font-head); font-size: 18px; font-weight: 600; color: var(--ink); }
  .faq summary::-webkit-details-marker { display: none; }
  .pm { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: var(--soft); color: var(--brand); flex: none; transition: transform .3s var(--ease), background .2s, color .2s; }
  .pm svg { width: 18px; height: 18px; }
  details[open] .pm { transform: rotate(45deg); background: var(--teal); color: #fff; }
  .faq details p { padding: 0 22px 22px; color: var(--muted); }

  @media (max-width: 1024px) {
    .svc-grid { grid-template-columns: 1fr; }
    .svc-panel { grid-template-columns: repeat(2, 1fr); }
    .svc-panel li:nth-child(3) { border-left: 0; }
    .svc-panel li:nth-child(n+3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 860px) {
    .split-head, .faq-grid { grid-template-columns: 1fr; }
    .split-text { padding-left: 0; border-left: 0; }
    .faq-intro { position: static; }
    .hero-shade { background: linear-gradient(180deg, rgba(8, 31, 58, .9), rgba(8, 31, 58, .82)); }
  }
  @media (max-width: 600px) {
    .hero { padding: 48px 0 56px; }
    .hero-text { font-size: 16px; }
    .hero-cta { justify-self: stretch; }
    .hero-cta .btn { flex: 1 1 160px; }
    .tile { padding: 20px 18px; }
    .svc-panel { grid-template-columns: 1fr; padding: 6px; }
    .svc-panel li + li { border-left: 0; border-top: 1px solid var(--line); }
    .svc-panel a { grid-template-columns: auto 1fr; justify-items: start; text-align: left; column-gap: 14px; row-gap: 4px; padding: 18px 14px; }
    .svc-panel a :global(svg) { grid-row: span 2; width: 30px; height: 30px; }
    .quote blockquote { font-size: 16px; }
    .faq summary { padding: 18px; font-size: 17px; } .faq details p { padding: 0 18px 18px; }
  }
</style>
