---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { getPage } from '../lib/content';
import { contact, socials, mapEmbed } from '../data/nav';

const page = getPage('contact-us');
const story = page.groups.find((g) => g.lead && g.lead.length > 200);
---
<Base quickActions={false} title="Contact Us" description="Get in touch with NeoVentraX — recruitment, staffing and career support. Call +1 (872) 227-9172 or email hr@neoventrax.com." heroImage={page.heroImage}>
  <PageHero
    title="Let’s talk hiring"
    eyebrow="Contact us"
    image={page.heroImage}
    lead="Whether you’re building a team or looking for your next role, we’re here to connect talent with purpose."
  />

  <section class="section">
    <div class="container contact-grid">
      <div class="info">
        <h2 class="h2">{story?.heading ?? 'Embrace innovation'}</h2>
        {story && <div class="prose" set:html={story.lead} />}
        <ul class="methods">
          <li>
            <span class="icon-tile"><Icon name="phone" /></span>
            <div><span>Call us</span><a href={contact.phoneHref}>{contact.phone}</a></div>
          </li>
          <li>
            <span class="icon-tile"><Icon name="mail" /></span>
            <div><span>Email</span><a href={`mailto:${contact.email}`}>{contact.email}</a></div>
          </li>
          <li>
            <span class="icon-tile"><Icon name="pin" /></span>
            <div><span>Visit</span><address>{contact.address[0]}<br />{contact.address[1]}</address></div>
          </li>
        </ul>
        <ul class="soc">
          {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener" aria-label={s.label}><Icon name={s.name} /></a></li>)}
        </ul>
      </div>
      <div class="form-card card">
        <h2 class="h3">Send us a message</h2>
        <p class="sub">We typically reply within one business day.</p>
        <ContactForm />
      </div>
    </div>
  </section>

  <section class="map-wrap">
    <iframe src={mapEmbed} title="NeoVentraX office — 2501 Chatham Rd, Springfield, IL" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
  </section>
</Base>

<style>
  .contact-grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(36px, 6vw, 80px); align-items: start; }
  .info { display: grid; gap: 22px; }
  .info .h2 { font-size: clamp(28px, 3.2vw, 40px); }
  .methods { display: grid; gap: 14px; margin-top: 8px; }
  .methods li { display: flex; gap: 16px; align-items: center; padding: 16px; border: 1px solid var(--line); border-radius: 16px; }
  .methods .icon-tile { width: 48px; height: 48px; border-radius: 14px; color: #fff; }
  .methods .icon-tile svg { width: 22px; height: 22px; }
  .methods span { display: block; font-size: 13px; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: .08em; }
  .methods a, .methods address { font-style: normal; font-family: var(--font-head); font-size: 18px; font-weight: 600; color: var(--ink); line-height: 1.35; }
  .methods a { display: inline-block; padding: 8px 0; margin: -8px 0; word-break: break-word; }
  .methods a:hover { color: var(--brand); }
  .soc { display: flex; gap: 10px; }
  .soc a { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: var(--soft); color: var(--ink); transition: background .2s, color .2s; }
  .soc a:hover { background: var(--grad); color: #fff; }
  .soc svg { width: 18px; height: 18px; }
  .form-card { padding: clamp(28px, 4vw, 44px); box-shadow: var(--shadow); position: sticky; top: calc(var(--header-h) + 24px); }
  .form-card .sub { color: var(--muted); margin: 6px 0 24px; }
  .map-wrap iframe { width: 100%; height: 440px; border: 0; filter: saturate(.9); }
  @media (max-width: 980px) { .contact-grid { grid-template-columns: 1fr; } .form-card { position: static; order: -1; } }
  @media (max-width: 600px) { .form-card { padding: 24px 18px; } .methods li { padding: 14px; } .methods a, .methods address { font-size: 16px; } .map-wrap iframe { height: 320px; } }
</style>
