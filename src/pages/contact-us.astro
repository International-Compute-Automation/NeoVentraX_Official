---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import UsDotMap from '../components/UsDotMap.astro';
import Icon from '../components/Icon.astro';
import { contact, socials, mapEmbed } from '../data/nav';
---
<Base quickActions={false} title="Contact Us" description="Contact NeoVentraX — call +1 (872) 227-9172 or email hr@neoventrax.com. Specialized Non-IT recruitment for US businesses." heroImage="/uploads/2025-09-Contact-us-min-scaled.webp">
  <PageHero
    title="Contact Us"
    image="/uploads/2025-09-Contact-us-min-scaled.webp"
    lead="Let’s discuss your hiring needs. Our team is ready to support your recruitment requirements."
  />

  <section class="section-sm">
    <div class="container info-row">
      <ul class="methods">
        <li>
          <Icon name="pin" />
          <div><strong>Our Office</strong><address>{contact.address[0]}, {contact.address[1]}</address></div>
        </li>
        <li>
          <Icon name="mail" />
          <div><strong>Business Enquiries</strong><a href={`mailto:${contact.email}`}>{contact.email}</a></div>
        </li>
        <li>
          <Icon name="phone" />
          <div><strong>Phone</strong><a href={contact.phoneHref}>{contact.phone}</a></div>
        </li>
        <li>
          <Icon name="calendar" />
          <div><strong>Office Hours</strong><span>{contact.hours}</span></div>
        </li>
        <li class="soc">
          {socials.map((s) => <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}><Icon name={s.name} /></a>)}
        </li>
      </ul>
      <div class="map-side">
        <UsDotMap class="dotmap" />
        <p class="serving">Serving Businesses Across the United States</p>
      </div>
    </div>
  </section>

  <section class="section-sm bg-soft">
    <div class="container form-row">
      <div class="form-intro">
        <h2 class="h2 title-rule">Send Us a Message</h2>
        <p>Have a question about our services, or looking for your next role? Send us a message and we’ll reply within one business day.</p>
        <p>Hiring? Use our <a href="/hire-talent/">hiring request form</a> so we can get started right away.</p>
      </div>
      <div class="form-card card"><ContactForm /></div>
    </div>
  </section>

  <section class="map-wrap">
    <iframe src={mapEmbed} title="NeoVentraX office — 2501 Chatham Rd, Springfield, IL" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
  </section>
</Base>

<style>
  .info-row { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
  .methods { display: grid; gap: 22px; padding-right: clamp(0px, 3vw, 40px); border-right: 1px solid var(--line); }
  .methods li { display: flex; gap: 16px; align-items: flex-start; }
  .methods > li > :global(svg) { width: 26px; height: 26px; color: var(--teal); flex: none; margin-top: 2px; }
  .methods div { display: grid; gap: 2px; }
  .methods strong { font-family: var(--font-head); font-size: 17px; color: var(--ink); }
  .methods a, .methods address, .methods span { font-style: normal; color: var(--text); font-size: 16px; word-break: break-word; }
  .methods a { padding: 4px 0; margin: -4px 0; }
  .methods a:hover { color: var(--brand); }
  .soc { gap: 10px !important; }
  .soc a { width: 44px; height: 44px; margin: 0; padding: 0; border-radius: 10px; display: grid; place-items: center; background: var(--soft); color: var(--ink); transition: background .2s, color .2s; }
  .soc a:hover { background: var(--teal); color: #fff; }
  .soc :global(svg) { width: 18px; height: 18px; }
  .map-side { display: grid; grid-template-columns: 1.4fr .6fr; align-items: center; gap: 20px; }
  .map-side :global(.dotmap) { width: 100%; height: auto; }
  .serving { font-family: var(--font-head); font-weight: 700; font-size: clamp(20px, 2vw, 26px); line-height: 1.2; color: var(--ink); }
  .serving::after { content: ''; display: block; width: 56px; height: 4px; border-radius: 2px; background: var(--teal-2); margin-top: 14px; }
  .form-row { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .form-intro { display: grid; gap: 14px; }
  .form-intro .h2 { font-size: clamp(30px, 3.2vw, 40px); margin-bottom: 6px; }
  .form-intro a { color: var(--brand); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .form-card { padding: clamp(24px, 3.5vw, 40px); box-shadow: var(--shadow); border-radius: 12px; }
  .map-wrap iframe { width: 100%; height: 380px; border: 0; filter: saturate(.9); }
  @media (max-width: 980px) {
    .info-row, .form-row { grid-template-columns: 1fr; }
    .methods { border-right: 0; padding-right: 0; }
  }
  @media (max-width: 560px) { .map-side { grid-template-columns: 1fr; } .map-wrap iframe { height: 300px; } }
</style>
