---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { industryHref } from '../data/industries';
const { industries } = Astro.locals.site;

const values = ['Integrity', 'Focus', 'Partnership', 'Results'];
const facts = [
  { value: '2021', label: 'Founded in June 2021' },
  { value: '7', label: 'Specialist Non-IT sectors' },
  { value: '3', label: 'Countries we operate in — US, Australia & India' },
  { value: '4', label: 'Recruitment services' },
];
---
<Base title="About Us" description="NeoVentraX is a US-focused, Non-IT recruitment specialist helping businesses hire qualified professionals across key industries." heroImage="/uploads/2025-09-About-Company-scaled.webp">
  <PageHero title="About NeoVentraX" image="/uploads/2025-09-About-Company-scaled.webp" lead="A focused recruitment partner for US businesses." />

  <section class="section-sm">
    <div class="container who">
      <div class="who-copy">
        <h2 class="h2 title-rule">Who We Are</h2>
        <p>NeoVentraX is a US-focused, Non-IT recruitment specialist helping businesses hire qualified professionals across key industries. We combine targeted talent research, industry knowledge and a structured recruitment approach to deliver the right talent for every role.</p>
        <p>Since our founding in June 2021, we have built recruitment teams with operations in the US, Australia and India — giving our clients research capacity across time zones and a dedicated point of contact throughout every search.</p>
      </div>
      <ul class="mvv">
        <li class="tile">
          <span class="ico"><Icon name="target" /></span>
          <h3>Our Mission</h3>
          <p>Connect businesses with the right talent to drive growth.</p>
        </li>
        <li class="tile">
          <span class="ico"><Icon name="eye" /></span>
          <h3>Our Vision</h3>
          <p>To be a trusted Non-IT recruitment partner for US businesses.</p>
        </li>
        <li class="tile">
          <span class="ico"><Icon name="gem" /></span>
          <h3>Our Values</h3>
          <ul class="checks">{values.map((v) => <li><Icon name="check" />{v}</li>)}</ul>
        </li>
      </ul>
    </div>
  </section>

  <section class="facts-band">
    <div class="container">
      <ul class="facts">
        {facts.map((f) => <li><strong>{f.value}</strong><span>{f.label}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section-sm">
    <div class="container two">
      <div>
        <h2 class="h2 title-rule">Sectors We Focus On</h2>
        <p class="lead">We recruit professional and operational talent outside the IT sector — the people who build, make, move, check and finance the products and services businesses depend on.</p>
        <div class="links">
          <a href="/why-neoventrax/" class="link-arrow">Why NeoVentraX <Icon name="arrow" /></a>
          <a href="/people/" class="link-arrow">Our people <Icon name="arrow" /></a>
          <a href="/careers/" class="link-arrow">Careers <Icon name="arrow" /></a>
        </div>
      </div>
      <ul class="ind-list">
        {industries.map((i) => (
          <li><a href={industryHref(i.slug)}><span><Icon name={i.icon} /></span>{i.title}<Icon name="arrow" class="go" /></a></li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .who { display: grid; grid-template-columns: 1fr 1.25fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .who-copy { display: grid; gap: 16px; }
  .who-copy .h2 { font-size: clamp(30px, 3.2vw, 40px); margin-bottom: 6px; }
  .who-copy p { color: var(--text); }
  .mvv { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .tile { display: grid; justify-items: center; align-content: start; text-align: center; gap: 10px; padding: 26px 18px; border-radius: 10px; background: var(--soft); border: 1px solid #e3ecf3; }
  .ico { color: var(--teal); }
  .ico :global(svg) { width: 40px; height: 40px; stroke-width: 1.6; }
  .tile h3 { font-size: 18px; }
  .tile p { color: var(--muted); font-size: 15px; }
  .checks { display: grid; gap: 6px; justify-items: start; }
  .checks li { display: flex; align-items: center; gap: 8px; font-size: 15px; color: var(--text); }
  .checks :global(svg) { width: 16px; height: 16px; color: var(--teal); stroke-width: 3; }
  .facts-band { background: linear-gradient(100deg, #0b2440 0%, #12385f 100%); padding: clamp(32px, 4vw, 48px) 0; }
  .facts { display: grid; grid-template-columns: repeat(4, 1fr); }
  .facts li { display: grid; gap: 4px; justify-items: center; text-align: center; padding: 8px 16px; color: #cfdcea; font-size: 15px; }
  .facts li + li { border-left: 1px solid rgba(255, 255, 255, .15); }
  .facts strong { font-family: var(--font-head); font-size: clamp(32px, 3.4vw, 44px); color: #fff; line-height: 1.1; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
  .two .h2 { font-size: clamp(30px, 3.2vw, 40px); margin-bottom: 18px; }
  .links { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 18px; }
  .ind-list { display: grid; gap: 10px; }
  .ind-list a { display: flex; align-items: center; gap: 14px; padding: 12px 16px; border: 1px solid var(--line); border-radius: 10px; font-family: var(--font-head); font-weight: 600; color: var(--ink); transition: border-color .2s, color .2s; }
  .ind-list a:hover { border-color: var(--brand); color: var(--brand); }
  .ind-list span { width: 40px; height: 40px; border-radius: 8px; display: grid; place-items: center; background: #e6f1f8; color: var(--brand); flex: none; }
  .ind-list span :global(svg) { width: 22px; height: 22px; }
  .ind-list :global(.go) { width: 18px; height: 18px; margin-left: auto; color: var(--muted); }
  @media (max-width: 980px) { .who, .two { grid-template-columns: 1fr; } }
  @media (max-width: 760px) {
    .facts { grid-template-columns: 1fr 1fr; row-gap: 20px; }
    .facts li:nth-child(3) { border-left: 0; }
  }
  @media (max-width: 560px) { .mvv { grid-template-columns: 1fr; } .tile { justify-items: start; text-align: left; } }
</style>
