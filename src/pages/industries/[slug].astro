---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import JobCard from '../../components/JobCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { rolesOf } from '../../lib/industries';
import { industryHref } from '../../data/industries';
import { sectorPage, withSector } from '../../data/industries-page';

// rendered on each request from the live sectors in the site database
const { industries, industriesPage: pg } = Astro.locals.site;
const industry = industries.find((i) => i.slug === Astro.params.slug);
if (!industry) return Astro.rewrite('/404/');
const roles = rolesOf(industry);
const others = industries.filter((i) => i.slug !== industry.slug);
const total = industry.levels.reduce((n, l) => n + l.roles.length, 0);
const { title, lead, description } = sectorPage(industry);
const t = (text: string) => withSector(text, industry.title);
---
<Base title={title} description={description} heroImage={industry.image}>
  <PageHero
    title={title}
    image={industry.image}
    lead={lead}
    crumbs={[{ label: 'Industries', href: '/industries/' }]}
  />

  <section class="section-sm">
    <div class="container exp">
      <div class="exp-copy">
        <h2 class="h2 title-rule">{pg.expertiseHeading}</h2>
        {industry.intro.map((p) => <p>{p}</p>)}
        <div class="exp-cta">
          <a href="/hire-talent/" class="btn btn-primary">{t(pg.hireButton)} <Icon name="arrow" /></a>
          <a href="/submit-your-resume/" class="link-arrow">{pg.resumeLink} <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="roles-box">
        <h2 class="h3">{pg.rolesHeading} <span>{total} {pg.positionsLabel}</span></h2>
        {industry.levels.map((l) => (
          <div class="lvl">
            <h3>{l.label}</h3>
            <ul>{l.roles.map((r) => <li><Icon name="check" />{r}</li>)}</ul>
          </div>
        ))}
        <p class="more">{pg.moreText} <a href="/hire-talent/">{pg.moreLinkText}</a>.</p>
      </div>
    </div>
  </section>

  <section class="section-sm bg-soft" id="roles">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{pg.featuredEyebrow}</span>
        <h2 class="h2">{t(pg.featuredHeading)}</h2>
        <p class="lead">{pg.featuredLead}</p>
      </div>
      <div class="grid grid-3">
        {roles.map((c) => <JobCard card={c} industry={industry.title} />)}
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <h2 class="h3 rt">{pg.otherSectorsHeading}</h2>
      <ul class="rel">
        {others.map((i) => <li><a href={industryHref(i.slug)}><Icon name={i.icon} />{i.title}</a></li>)}
      </ul>
    </div>
  </section>

  <CtaBand title={t(pg.sectorCtaTitle)} text={pg.sectorCtaText} />
</Base>

<style>
  .exp { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .exp-copy { display: grid; gap: 14px; }
  .exp-copy .h2 { font-size: clamp(30px, 3.2vw, 40px); margin-bottom: 8px; }
  .exp-copy p { color: var(--text); }
  .exp-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; margin-top: 8px; }
  .roles-box { padding: clamp(22px, 3vw, 32px); border-radius: 12px; background: var(--soft); border: 1px solid #e3ecf3; display: grid; gap: 20px; }
  .roles-box > .h3 { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 16px; font-size: 22px; }
  .roles-box > .h3 span { font-family: var(--font-body); font-size: 14px; font-weight: 600; color: var(--teal); }
  .lvl h3 { font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--brand); margin-bottom: 10px; }
  .lvl ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 20px; }
  .lvl li { display: flex; gap: 9px; align-items: flex-start; font-size: 15px; color: var(--text); line-height: 1.4; }
  .lvl :global(svg) { width: 16px; height: 16px; flex: none; margin-top: 2px; color: var(--teal); stroke-width: 3; }
  .lvl + .lvl { padding-top: 18px; border-top: 1px solid #dbe6ef; }
  .more { font-size: 15px; color: var(--muted); }
  .more a { color: var(--brand); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .rt { margin-bottom: 20px; }
  .rel { display: flex; flex-wrap: wrap; gap: 10px; }
  .rel a { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 10px 18px; border: 1px solid var(--line); border-radius: 10px; font-family: var(--font-head); font-weight: 600; color: var(--ink); transition: border-color .2s, color .2s; }
  .rel a:hover { border-color: var(--brand); color: var(--brand); }
  .rel :global(svg) { width: 20px; height: 20px; color: var(--brand); }
  @media (max-width: 980px) { .exp { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .lvl ul { grid-template-columns: 1fr; } .rel a { width: 100%; } }
</style>
