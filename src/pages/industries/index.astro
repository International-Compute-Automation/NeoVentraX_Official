---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import IndustryGrid from '../../components/IndustryGrid.astro';
import CtaBand from '../../components/CtaBand.astro';
const pg = Astro.locals.site.industriesPage;
---
<Base title={pg.seoTitle} description={pg.seoDescription} heroImage={pg.heroImage}>
  <PageHero
    title={pg.heroTitle}
    image={pg.heroImage}
    lead={pg.heroLead}
  />
  <section class="section-sm bg-soft">
    <div class="container">
      <IndustryGrid />
    </div>
  </section>
  <CtaBand title={pg.listingCtaTitle} text={pg.listingCtaText} />
</Base>
