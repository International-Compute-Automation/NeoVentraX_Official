# Copy to .env for local runs. On the server these live in ~/neoventrax-dev/shared/.env and ~/neoventrax-prod/shared/.env.

# Site-content database written by the CMS (read-only role). Empty -> the site shows its built-in Industries content.
SITE_DATABASE_URL=postgres://nvx_site_reader:<password>@127.0.0.1:5432/neoventrax_site

# Forms (src/pages/api/forms.ts): the mailbox that sends the submission emails.
# Port 587 = STARTTLS, 465 = SSL. Microsoft 365: smtp.office365.com:587, Google Workspace: smtp.gmail.com:587 (app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Who receives the submissions (comma-separated). Default rizwan@icacorp.org
FORM_MAIL_TO=rizwan@icacorp.org
# Sender shown on the emails. Default SMTP_USER; most providers only allow the SMTP_USER address (or its aliases).
FORM_MAIL_FROM=
